generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Floor {
  floor_id        Int      @id @default(autoincrement())
  floor_name      String
  total_seats     Int
  floor_image_url String?
  seats           Seat[]
}

model Seat {
  seat_id        Int           @id @default(autoincrement())
  floor_id       Int
  row_label      String
  seat_number    Int
  zone_type      String
  has_outlet     Boolean       @default(false)
  near_ac        Boolean       @default(false)
  is_window_seat Boolean       @default(false)
  comfort_score  Int
  floor          Floor         @relation(fields: [floor_id], references: [floor_id])
  seat_status    SeatStatus?
  logs           OccupancyLog[]
}

model SeatStatus {
  seat_id      Int      @id
  is_occupied  Boolean  @default(false)
  last_updated DateTime @default(now()) @updatedAt
  seat         Seat     @relation(fields: [seat_id], references: [seat_id])
}

model OccupancyLog {
  log_id    Int      @id @default(autoincrement())
  seat_id   Int
  status    String
  timestamp DateTime @default(now())
  seat      Seat     @relation(fields: [seat_id], references: [seat_id])
}

model Student {
  reg_number String   @id
  name       String
  email      String
  password   String
  last_login DateTime @default(now())
}

model Faculty {
  faculty_id String   @id
  name       String
  email      String
  password   String
  department String
  last_login DateTime @default(now())
}

model Admin {
  admin_id   String   @id
  name       String
  email      String
  password   String
  last_login DateTime @default(now())
}